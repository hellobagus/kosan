generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  TENANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum TenantStatus {
  ACTIVE
  RESERVED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  TRANSFER
  MIDTRANS
}

enum PaymentRecordStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model User {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  password      String   @db.VarChar(255)
  phone         String?  @db.VarChar(20)
  role          UserRole @default(TENANT)
  address       String?
  gender        String?  @db.VarChar(20)
  ktp           String?  @db.VarChar(20)
  maritalStatus String?  @map("marital_status") @db.VarChar(30)
  occupation    String?  @db.VarChar(100)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenants       Tenant[]
  finances      Finance[] @relation("CreatedBy")

  @@index([role])
  @@map("users")
}

model Room {
  id          Int        @id @default(autoincrement())
  roomNumber  String     @unique @map("room_number") @db.VarChar(20)
  floor       Int        @default(1)
  price       Decimal    @db.Decimal(12, 2)
  dailyPrice  Decimal?   @map("daily_price") @db.Decimal(12, 2)
  facilities  String?
  equipment   String?
  description String?
  status      RoomStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenants  Tenant[]
  finances Finance[]

  @@index([status])
  @@map("rooms")
}

model Tenant {
  id              Int           @id @default(autoincrement())
  userId          Int           @map("user_id")
  roomId          Int           @map("room_id")
  checkIn         DateTime      @map("check_in") @db.Date
  checkOut        DateTime?     @map("check_out") @db.Date
  dueDate         DateTime?     @map("due_date") @db.Date
  monthlyRent     Decimal       @map("monthly_rent") @db.Decimal(12, 2)
  deposit         Decimal       @default(0) @db.Decimal(12, 2)
  status          TenantStatus  @default(ACTIVE)
  leaseDuration   String?       @map("lease_duration") @db.VarChar(30)
  occupantCount   Int           @default(1) @map("occupant_count")
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  additionalFees  Json?         @map("additional_fees")
  totalAmount     Decimal?      @map("total_amount") @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  invoiceNumber   String?       @map("invoice_number") @db.VarChar(20)
  lastPaymentDate DateTime?     @map("last_payment_date") @db.Date
  extensionDate   DateTime?     @map("extension_date") @db.Date
  isDaily         Boolean       @default(false) @map("is_daily")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  finances Finance[]
  payments Payment[]

  @@index([status])
  @@index([userId])
  @@index([roomId])
  @@map("tenants")
}

model Payment {
  id            Int                 @id @default(autoincrement())
  tenantId      Int                 @map("tenant_id")
  amount        Decimal             @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentRecordStatus @default(PENDING)
  orderId       String              @unique @map("order_id") @db.VarChar(60)
  transactionId String?             @map("transaction_id") @db.VarChar(100)
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("payments")
}

model Finance {
  id              Int             @id @default(autoincrement())
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  description     String          @db.VarChar(255)
  category        String?         @db.VarChar(100)
  transactionDate DateTime        @default(now()) @map("transaction_date") @db.Date
  tenantId        Int?            @map("tenant_id")
  roomId          Int?            @map("room_id")
  createdBy       Int?            @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  room      Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdByUser User? @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([transactionDate])
  @@index([type, transactionDate])
  @@map("finances")
}
