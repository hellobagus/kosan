generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  TENANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum TenantStatus {
  ACTIVE
  RESERVED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum TenantPaymentType {
  FULL
  INSTALLMENT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  TRANSFER
  MIDTRANS
}

enum PaymentRecordStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum GalleryCategory {
  ROOM
  FACILITY
}

enum UtilityType {
  ELECTRICITY
  WATER
  INTERNET
  GAS
  OTHER
}

enum BillingMethod {
  METER
  LUMPSUM
}

enum AssetStatus {
  IN_WAREHOUSE
  DEPLOYED
  IN_USE
  DAMAGED
  MAINTENANCE
  RETIRED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionResult {
  OK
  DAMAGED
  MISSING
}

model KosanProfile {
  id                      Int      @id @default(1)
  name                    String   @default("KosanKu") @db.VarChar(150)
  address                 String?
  phone                   String?  @db.VarChar(30)
  email                   String?  @db.VarChar(150)
  logoUrl                 String?  @map("logo_url")
  gracePeriodDays         Int      @default(3) @map("grace_period_days")
  latePenaltyPerDay       Decimal  @default(50000) @map("late_penalty_per_day") @db.Decimal(12, 2)
  paymentNotes            String?  @map("payment_notes")
  termsAndConditions      String?  @map("terms_and_conditions")
  yearlyLeaseBonusEnabled Boolean  @default(true) @map("yearly_lease_bonus_enabled")
  yearlyLeaseBonusMonths  Int      @default(1) @map("yearly_lease_bonus_months")
  leaseBonusRules         Json?    @map("lease_bonus_rules")
  leasePackages           Json?    @map("lease_packages")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("kosan_profile")
}

model BankAccount {
  id            Int     @id @default(autoincrement())
  bankName      String  @map("bank_name") @db.VarChar(50)
  accountNumber String  @map("account_number") @db.VarChar(30)
  accountHolder String  @map("account_holder") @db.VarChar(100)
  sortOrder     Int     @default(0) @map("sort_order")

  @@map("bank_accounts")
}

model GalleryImage {
  id        Int             @id @default(autoincrement())
  category  GalleryCategory
  url       String
  caption   String?         @db.VarChar(150)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([category])
  @@map("gallery_images")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  password      String   @db.VarChar(255)
  phone         String?  @db.VarChar(20)
  role          UserRole @default(TENANT)
  address       String?
  gender        String?  @db.VarChar(20)
  ktp           String?  @db.VarChar(20)
  maritalStatus String?  @map("marital_status") @db.VarChar(30)
  occupation    String?  @db.VarChar(100)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenants       Tenant[]
  finances      Finance[] @relation("CreatedBy")
  purchases     Purchase[] @relation("PurchaseCreatedBy")
  assetMaintenances AssetMaintenance[] @relation("MaintenanceCreatedBy")
  checkoutInspections CheckoutInspection[] @relation("InspectionBy")

  @@index([role])
  @@map("users")
}

model Room {
  id          Int        @id @default(autoincrement())
  roomNumber  String     @unique @map("room_number") @db.VarChar(20)
  floor       Int        @default(1)
  price       Decimal    @db.Decimal(12, 2)
  dailyPrice  Decimal?   @map("daily_price") @db.Decimal(12, 2)
  facilities  String?
  equipment   String?
  description String?
  status      RoomStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenants       Tenant[]
  finances      Finance[]
  roomUtilities RoomUtility[]
  utilityBills  UtilityBilling[]
  roomAssets    RoomAsset[]
  assetMaintenances AssetMaintenance[]
  checkoutInspections CheckoutInspection[]

  @@index([status])
  @@map("rooms")
}

model Tenant {
  id              Int           @id @default(autoincrement())
  userId          Int           @map("user_id")
  roomId          Int           @map("room_id")
  checkIn         DateTime      @map("check_in") @db.Date
  checkOut        DateTime?     @map("check_out") @db.Date
  dueDate         DateTime?     @map("due_date") @db.Date
  monthlyRent     Decimal       @map("monthly_rent") @db.Decimal(12, 2)
  deposit         Decimal       @default(0) @db.Decimal(12, 2)
  status          TenantStatus  @default(ACTIVE)
  leaseDuration   String?       @map("lease_duration") @db.VarChar(30)
  occupantCount   Int           @default(1) @map("occupant_count")
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  additionalFees  Json?         @map("additional_fees")
  totalAmount     Decimal?      @map("total_amount") @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paymentStatus        PaymentStatus     @default(UNPAID) @map("payment_status")
  paymentType          TenantPaymentType @default(FULL) @map("payment_type")
  leaseBonusMonths     Int               @default(0) @map("lease_bonus_months")
  leaseGift            String?           @map("lease_gift")
  invoiceNumber        String?           @map("invoice_number") @db.VarChar(20)
  lastPaymentDate DateTime?     @map("last_payment_date") @db.Date
  extensionDate   DateTime?     @map("extension_date") @db.Date
  isDaily              Boolean       @default(false) @map("is_daily")
  emergencyPhone       String?       @map("emergency_phone") @db.VarChar(20)
  additionalOccupants  Json?         @map("additional_occupants")
  termsAcceptedAt      DateTime?     @map("terms_accepted_at")
  contractRequested    Boolean       @default(false) @map("contract_requested")
  notes                String?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  finances     Finance[]
  payments     Payment[]
  utilityBills UtilityBilling[]
  roomAssets   RoomAsset[]
  assetMaintenances AssetMaintenance[]
  checkoutInspections CheckoutInspection[]

  @@index([status])
  @@index([userId])
  @@index([roomId])
  @@map("tenants")
}

model Payment {
  id            Int                 @id @default(autoincrement())
  tenantId      Int                 @map("tenant_id")
  amount        Decimal             @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentRecordStatus @default(PENDING)
  orderId       String              @unique @map("order_id") @db.VarChar(60)
  transactionId String?             @map("transaction_id") @db.VarChar(100)
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("payments")
}

model Finance {
  id              Int             @id @default(autoincrement())
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  description     String          @db.VarChar(255)
  category        String?         @db.VarChar(100)
  transactionDate DateTime        @default(now()) @map("transaction_date") @db.Date
  tenantId        Int?            @map("tenant_id")
  roomId          Int?            @map("room_id")
  createdBy       Int?            @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  room      Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdByUser User? @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  purchases Purchase[]
  assetMaintenances AssetMaintenance[]

  @@index([type])
  @@index([transactionDate])
  @@index([type, transactionDate])
  @@map("finances")
}

model Utility {
  id            Int           @id @default(autoincrement()) @map("utility_id")
  utilityName   String        @map("utility_name") @db.VarChar(100)
  utilityType   UtilityType   @map("utility_type")
  billingMethod BillingMethod @map("billing_method")
  amount        Decimal       @db.Decimal(12, 2)
  unitLabel     String?       @map("unit_label") @db.VarChar(20)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  roomUtilities RoomUtility[]
  billings      UtilityBilling[]
  roomAssets    RoomAsset[]

  @@map("utilities")
}

model RoomUtility {
  id           Int      @id @default(autoincrement())
  roomId       Int      @map("room_id")
  utilityId    Int      @map("utility_id")
  lastReading  Decimal? @map("last_reading") @db.Decimal(12, 2)
  customAmount Decimal? @map("custom_amount") @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  utility Utility @relation(fields: [utilityId], references: [id], onDelete: Cascade)

  @@unique([roomId, utilityId])
  @@index([roomId])
  @@map("room_utilities")
}

model UtilityBilling {
  id            Int           @id @default(autoincrement())
  roomId        Int           @map("room_id")
  utilityId     Int           @map("utility_id")
  tenantId      Int?          @map("tenant_id")
  periodMonth   Int           @map("period_month")
  periodYear    Int           @map("period_year")
  prevReading   Decimal?      @map("prev_reading") @db.Decimal(12, 2)
  currReading   Decimal?      @map("curr_reading") @db.Decimal(12, 2)
  usage         Decimal?      @db.Decimal(12, 2)
  ratePerUnit   Decimal       @map("rate_per_unit") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  invoicedAt    DateTime?     @map("invoiced_at")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  utility Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  tenant  Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([roomId, utilityId, periodMonth, periodYear])
  @@index([periodYear, periodMonth])
  @@index([tenantId])
  @@map("utility_billings")
}

model InventoryCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  items InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id          Int      @id @default(autoincrement())
  sku         String?  @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  categoryId  Int?     @map("category_id")
  unit        String   @default("unit") @db.VarChar(20)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category         InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  warehouseStock   WarehouseStock?
  assets           RoomAsset[]
  purchaseItems    PurchaseItem[]
  warehouseEntries WarehouseEntry[]

  @@map("inventory_items")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  email     String?  @db.VarChar(150)
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id             Int            @id @default(autoincrement())
  purchaseNumber String         @unique @map("purchase_number") @db.VarChar(30)
  supplierId     Int?           @map("supplier_id")
  purchaseDate   DateTime       @default(now()) @map("purchase_date") @db.Date
  totalAmount    Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  status         PurchaseStatus @default(DRAFT)
  notes          String?
  financeId      Int?           @map("finance_id")
  receivedAt     DateTime?      @map("received_at")
  createdBy      Int?           @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  supplier         Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdByUser    User?            @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  finance          Finance?         @relation(fields: [financeId], references: [id], onDelete: SetNull)
  items            PurchaseItem[]
  warehouseEntries WarehouseEntry[]

  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id         Int     @id @default(autoincrement())
  purchaseId Int     @map("purchase_id")
  itemId     Int     @map("item_id")
  quantity   Int     @default(1)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  purchase Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("purchase_items")
}

model WarehouseStock {
  id        Int      @id @default(autoincrement())
  itemId    Int      @unique @map("item_id")
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("warehouse_stocks")
}

model WarehouseEntry {
  id         Int      @id @default(autoincrement())
  purchaseId Int?     @map("purchase_id")
  itemId     Int      @map("item_id")
  quantity   Int
  entryDate  DateTime @default(now()) @map("entry_date") @db.Date
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  purchase Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("warehouse_entries")
}

model RoomAsset {
  id            Int         @id @default(autoincrement())
  assetCode     String      @unique @map("asset_code") @db.VarChar(30)
  itemId        Int         @map("item_id")
  roomId        Int?        @map("room_id")
  tenantId      Int?        @map("tenant_id")
  utilityId     Int?        @map("utility_id")
  status        AssetStatus @default(IN_WAREHOUSE)
  purchasePrice Decimal?    @map("purchase_price") @db.Decimal(12, 2)
  deployedAt    DateTime?   @map("deployed_at")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  item         InventoryItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  room         Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  tenant       Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  utility      Utility?             @relation(fields: [utilityId], references: [id], onDelete: SetNull)
  maintenances AssetMaintenance[]
  inspections  CheckoutInspection[]
  transactions AssetTransaction[]

  @@index([status])
  @@index([roomId])
  @@index([tenantId])
  @@map("room_assets")
}

model AssetMaintenance {
  id          Int               @id @default(autoincrement())
  assetId     Int               @map("asset_id")
  roomId      Int?              @map("room_id")
  tenantId    Int?              @map("tenant_id")
  title       String            @db.VarChar(200)
  description String?
  status      MaintenanceStatus @default(OPEN)
  cost        Decimal           @default(0) @db.Decimal(12, 2)
  reportedAt  DateTime          @default(now()) @map("reported_at")
  completedAt DateTime?         @map("completed_at")
  financeId   Int?              @map("finance_id")
  createdBy   Int?              @map("created_by")

  asset         RoomAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  room          Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdByUser User?     @relation("MaintenanceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  finance       Finance?  @relation(fields: [financeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("asset_maintenances")
}

model CheckoutInspection {
  id              Int              @id @default(autoincrement())
  tenantId        Int              @map("tenant_id")
  roomId          Int              @map("room_id")
  assetId         Int              @map("asset_id")
  result          InspectionResult @default(OK)
  damageCost      Decimal          @default(0) @map("damage_cost") @db.Decimal(12, 2)
  depositDeducted Decimal          @default(0) @map("deposit_deducted") @db.Decimal(12, 2)
  notes           String?
  inspectedAt     DateTime         @default(now()) @map("inspected_at")
  inspectedBy     Int?             @map("inspected_by")

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  asset           RoomAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspectedByUser User?     @relation("InspectionBy", fields: [inspectedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("checkout_inspections")
}

model AssetTransaction {
  id         Int          @id @default(autoincrement())
  assetId    Int          @map("asset_id")
  action     String       @db.VarChar(50)
  fromStatus AssetStatus? @map("from_status")
  toStatus   AssetStatus? @map("to_status")
  roomId     Int?         @map("room_id")
  tenantId   Int?         @map("tenant_id")
  notes      String?
  createdBy  Int?         @map("created_by")
  createdAt  DateTime     @default(now()) @map("created_at")

  asset RoomAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_transactions")
}
